+// The layout editor's card (DmGamepad.m, "Edit control layout" in the in-game menu): supports global and per-button resizing up to 400%,
+// free drag positioning, opacity, Split ABXY for individual A/B/X/Y editing, collapsible compact bar, and custom macro buttons (e.g. X+A).
+@interface DmPadEditCard : UIView
+@property (nonatomic, copy) void (^onSize)(CGFloat);
+@property (nonatomic, copy) void (^onOpacity)(CGFloat);
+@property (nonatomic, copy) void (^onApart)(BOOL);
