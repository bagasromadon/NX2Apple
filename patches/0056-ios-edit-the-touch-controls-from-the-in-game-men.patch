+- (void)toggleBit:(int)bit {
+    uint64_t flag = 1ull << bit;
+    if (_mask & flag) {
+        _mask &= ~flag;
+        for (int i = 0; i < _orderLen; i++) if (_order[i] == bit) {
+            for (int j = i; j + 1 < _orderLen; j++) _order[j] = _order[j + 1];
+            _orderLen--; break;
+        }
+    } else {
+        _mask |= flag;
+        if (_orderLen < 16) _order[_orderLen++] = bit;
+    }
+    [self refreshState];
+}
+- (void)clearBits { _mask = 0; _orderLen = 0; _labelField.text = @""; [self refreshState]; }
+- (NSString *)computedLabel {
+    NSString *typed = [_labelField.text stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+    if (typed.length) return typed;
+    if (!_mask) return @"";
+    if (_orderLen > 0) {
+        NSMutableString *s = [NSMutableString string];
+        for (int i = 0; i < _orderLen; i++) {
+            int b = _order[i];
+            if (!((_mask >> b) & 1ull)) continue;
+            if (s.length) [s appendString:@"+"];
+            [s appendString:@(dm_pad_btn_labels[b])];
+        }
+        if (s.length) return s;
+    }
