+        g.faceKeyR[i] = fmin(DM_PAD_FACE_R * u0 * g.controlScale[DM_PAD_C_A + i], maxR);
+        g.faceKeyHitR[i] = MAX(g.faceKeyR[i] * 1.25, layout.separated ? 22 : 0);
