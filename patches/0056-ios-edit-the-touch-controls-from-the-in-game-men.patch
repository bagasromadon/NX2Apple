+@property (nonatomic, copy) void (^onAddMacro)(void);
+@property (nonatomic, copy) void (^onEditMacro)(void);
+@property (nonatomic, copy) void (^onDeleteMacro)(void);
+@property (nonatomic, copy) void (^onReset)(BOOL includeMacros);
+@property (nonatomic, copy) void (^onCancel)(void);
+@property (nonatomic, copy) void (^onDone)(void);
+- (instancetype)initWithScale:(CGFloat)scale opacity:(CGFloat)opacity apart:(BOOL)apart min:(CGFloat)smin max:(CGFloat)smax opacityMin:(CGFloat)omin;
+- (void)setSelectionName:(NSString *)name isMacro:(BOOL)isMacro hasSelection:(BOOL)hasSelection scale:(CGFloat)scale opacity:(CGFloat)opacity apart:(BOOL)apart macroCount:(int)macroCount;
+- (CGSize)fittedSizeForWidth:(CGFloat)w;
+- (CGFloat)minimumUsableWidth;
+@end
+@implementation DmPadEditCard {
+    UISlider *_size, *_opacity;
+    UILabel *_badge, *_subtitle, *_sizeName, *_sizeValue, *_opacityValue, *_contextHint;
+    UISwitch *_apart;
+    UIButton *_allBtn, *_collapseBtn, *_resetItemBtn, *_editMacroBtn, *_deleteMacroBtn, *_addMacroBtn, *_doneCompactBtn;
+    UIStackView *_bodyStack;
+    NSArray<UIView *> *_widthRows;   // the rows that must stay on one line (title, context, actions)
+    CGFloat _minWidth;               // cached width those rows need; 0 = measure again
+    BOOL _collapsed, _hasSelection, _wasMacro, _wasFull;
+}
+static UILabel *edit_label(NSString *text, CGFloat size, UIFontWeight weight, CGFloat alpha) {
+    UILabel *l = [UILabel new]; l.text = text; l.font = [UIFont systemFontOfSize:size weight:weight]; l.textColor = [UIColor colorWithWhite:1 alpha:alpha]; l.numberOfLines = 0;
+    return l;
+}
+// Every button on the two cards keeps its title on one horizontal line. A UIButtonConfiguration title takes its font from Dynamic Type and
+// wraps when its row runs out of room, so a raised text size (or a narrow screen) turned "Cancel" and "Reset" into a column of single
+// letters. Three things keep the words flat: the title font is pinned to the card's own scale (every label here is a fixed size too), the
+// title label is held to a single line, and the button resists being squeezed below that line, so the row's spacer closes up first. The
+// card then widens itself to the width the rows actually need (minimumUsableWidth below), up to the safe area.
+static UIFont *edit_capped_font(CGFloat size, UIFontWeight weight) {   // follows the text size setting, but only up to +3pt: the cards are fixed-size panels
+    UIFont *base = [UIFont systemFontOfSize:size weight:weight];
+    return [[UIFontMetrics metricsForTextStyle:UIFontTextStyleSubheadline] scaledFontForFont:base maximumPointSize:size + 3];
+}
+static UIButtonConfiguration *edit_flat_title(UIButtonConfiguration *c, CGFloat size) {
+    c.titleTextAttributesTransformer = ^NSDictionary<NSAttributedStringKey, id> *(NSDictionary<NSAttributedStringKey, id> *attrs) {
+        NSMutableDictionary<NSAttributedStringKey, id> *out = [attrs mutableCopy];
+        out[NSFontAttributeName] = edit_capped_font(size, UIFontWeightSemibold);
+        return out;
+    };
+    return c;
+}
+static void edit_one_line(UIButton *b) {
+    b.titleLabel.numberOfLines = 1; b.titleLabel.lineBreakMode = NSLineBreakByTruncatingTail;
+    b.titleLabel.adjustsFontSizeToFitWidth = YES; b.titleLabel.minimumScaleFactor = 0.75;
+    [b setContentCompressionResistancePriority:UILayoutPriorityRequired - 1 forAxis:UILayoutConstraintAxisHorizontal];
+    [b setContentHuggingPriority:UILayoutPriorityDefaultHigh forAxis:UILayoutConstraintAxisHorizontal];
+    [b.heightAnchor constraintGreaterThanOrEqualToConstant:30].active = YES;   // the smaller title must not shrink the touch target
+    b.configurationUpdateHandler = ^(UIButton *btn) {   // a new title or state rebuilds the label: hold it to the one line (no self captured)
+        btn.titleLabel.numberOfLines = 1; btn.titleLabel.lineBreakMode = NSLineBreakByTruncatingTail;
+        btn.titleLabel.adjustsFontSizeToFitWidth = YES; btn.titleLabel.minimumScaleFactor = 0.75;
+    };
+}
+static UILabel *edit_flat_label(UILabel *l) {   // a row label never stacks its letters either: one line, shrink a little, then truncate
+    l.numberOfLines = 1; l.lineBreakMode = NSLineBreakByTruncatingTail;
+    l.adjustsFontSizeToFitWidth = YES; l.minimumScaleFactor = 0.8;
+    return l;
+}
+static CGFloat edit_rows_width(NSArray<UIView *> *rows) {   // the widest row at its natural size: what the card needs to stay on one line
+    CGFloat w = 0;
+    for (UIView *r in rows) {
+        if (r.hidden) continue;
+        w = fmax(w, ceil([r systemLayoutSizeFittingSize:UILayoutFittingCompressedSize].width));
+    }
+    return w;
+}
+- (UIStackView *)rowNamed:(UILabel *)nameLabel slider:(UISlider *)slider value:(UILabel *)value {
+    [nameLabel.widthAnchor constraintEqualToConstant:58].active = YES;
+    edit_flat_label(nameLabel);
+    value.font = [UIFont monospacedDigitSystemFontOfSize:13 weight:UIFontWeightMedium]; value.textAlignment = NSTextAlignmentRight;
+    edit_flat_label(value);
+    [value.widthAnchor constraintEqualToConstant:48].active = YES;
+    UIStackView *r = [[UIStackView alloc] initWithArrangedSubviews:@[nameLabel, slider, value]];
+    r.axis = UILayoutConstraintAxisHorizontal; r.spacing = 8; r.alignment = UIStackViewAlignmentCenter;
+    return r;
+}
+- (UIButton *)button:(NSString *)title style:(int)style tint:(UIColor *)tint action:(void (^)(void))block {
+    UIButtonConfiguration *c = style == 2 ? [UIButtonConfiguration filledButtonConfiguration] : style == 1 ? [UIButtonConfiguration tintedButtonConfiguration] : [UIButtonConfiguration plainButtonConfiguration];
+    c.title = title; c.buttonSize = UIButtonConfigurationSizeSmall; c.cornerStyle = UIButtonConfigurationCornerStyleCapsule;
+    c.contentInsets = NSDirectionalEdgeInsetsMake(5, 11, 5, 11);
+    c = edit_flat_title(c, 13);
+    if (tint) {
+        c.baseForegroundColor = tint;
+        if (style == 1 || style == 2) c.baseBackgroundColor = tint;
+    } else if (style == 0) {
+        c.baseForegroundColor = [UIColor colorWithRed:1 green:0.45 blue:0.4 alpha:1];
+    }
+    UIButton *b = [UIButton buttonWithConfiguration:c primaryAction:[UIAction actionWithHandler:^(UIAction *a) { (void)a; if (block) block(); }]];
+    edit_one_line(b);
+    return b;
+}
