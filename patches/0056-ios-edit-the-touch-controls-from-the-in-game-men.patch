+// ---- Editing the layout in the game ----
+// "Edit control layout" in the in-game menu (GameMenu.swift, dm_pad_edit_begin) supports global and per-control resizing (40%..400%),
+// free pixel-accurate drag positioning inside the screen bounds, Split ABXY for individual A/B/X/Y editing, opacity (15%..100%),
+// and custom multi-button macro buttons (Hold / Toggle / Turbo, e.g. X+A). Done saves all settings in NSUserDefaults (loadEdits reads
+// them at the next start). If DM_TOUCH_LAYOUT or DM_TOUCH_SIZE in the environment changed from the shell, saved layout/size edits drop so
+// the shell's settings win, while custom macro buttons are preserved.
+static NSString *edit_env_stamp(void) {
+    const char *l = getenv("DM_TOUCH_LAYOUT"), *s = getenv("DM_TOUCH_SIZE");
+    return [NSString stringWithFormat:@"%s|%s", l ? l : "", s ? s : ""];
+}
+static NSString *edit_control_display_name(int c) {
+    switch (c) {
+        case DM_PAD_C_STICK: return @"Left Stick";
+        case DM_PAD_C_DPAD: return @"D-Pad";
+        case DM_PAD_C_FACE: return @"ABXY";
+        case DM_PAD_C_A: return @"Button A";
+        case DM_PAD_C_B: return @"Button B";
+        case DM_PAD_C_X: return @"Button X";
+        case DM_PAD_C_Y: return @"Button Y";
+        case DM_PAD_C_ZL: return @"ZL";
+        case DM_PAD_C_L: return @"L";
+        case DM_PAD_C_ZR: return @"ZR";
+        case DM_PAD_C_R: return @"R";
+        case DM_PAD_C_MINUS: return @"Minus (−)";
+        case DM_PAD_C_PLUS: return @"Plus (+)";
+        case DM_PAD_C_L3: return @"L3";
+        case DM_PAD_C_R3: return @"R3";
+        default: return @"All Controls";
+    }
+}
+- (void)loadEdits {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    NSString *macroText = [d stringForKey:k_edit_macros_key]; DmPadMacros m;
+    if (macroText && dm_pad_macros_parse(macroText.UTF8String, &m)) _macros = m;
+    NSString *stamp = [d stringForKey:k_edit_stamp_key];
+    if (!stamp) return;
+    if (![stamp isEqualToString:edit_env_stamp()]) {   // the shell's settings changed since: its layout/size win (custom macros are kept)
+        for (NSString *k in @[k_edit_layout_key, k_edit_scale_key, k_edit_opacity_key, k_edit_custom_key, k_edit_stamp_key]) [d removeObjectForKey:k];
