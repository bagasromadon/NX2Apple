+static CGFloat edit_shape_distance(const DmPadShape *s, CGPoint p) {   // from p to the shape's outline, 0 inside it
+    if (s->isRect) return hypot(p.x - fmax(CGRectGetMinX(s->rect), fmin(p.x, CGRectGetMaxX(s->rect))), p.y - fmax(CGRectGetMinY(s->rect), fmin(p.y, CGRectGetMaxY(s->rect))));
+    return fmax(0, hypot(p.x - s->c.x, p.y - s->c.y) - s->r);
+}
+static CGFloat edit_shape_norm(const DmPadShape *s, CGPoint p) {   // normalized distance from shape centre (0 at centre, 1 at edge) for overlap disambiguation
+    if (s->isRect) {
+        CGFloat hw = fmax(s->rect.size.width / 2, 1), hh = fmax(s->rect.size.height / 2, 1);
+        return hypot((p.x - CGRectGetMidX(s->rect)) / hw, (p.y - CGRectGetMidY(s->rect)) / hh);
+    }
+    return hypot(p.x - s->c.x, p.y - s->c.y) / fmax(s->r, 1);
+}
+- (BOOL)editMovable:(int)c {   // the diamond as one control, or its four keys on their own
+    BOOL key = c >= DM_PAD_C_A && c <= DM_PAD_C_Y;
+    if (!dm_pad_control_drawn(c, _full)) return NO;
+    return c == DM_PAD_C_FACE ? !_editApart : key ? _editApart : YES;
+}
+- (int)editControlAt:(CGPoint)p {   // control or custom macro under p; overlapping scaled buttons disambiguate by normalized centre distance
+    const DmPadGeo *g = self.geo;
+    int set = [self editSet];
+    int bestInside = -1; CGFloat bestNorm = CGFLOAT_MAX;
+    int bestNear = -1; CGFloat bestDist = 16;
+    for (int i = 0; i < DM_PAD_MACRO_MAX; i++) {
+        const DmPadMacro *m = &_macros.items[set][i];
+        if (!m->active || !(m->mask & 0xFFFFu)) continue;
+        CGFloat r = 0; CGPoint mc = dm_pad_macro_center(g, _layout.separated, _layout.controls, m, &r);
+        CGFloat d = hypot(p.x - mc.x, p.y - mc.y);
+        if (d <= r) {
+            CGFloat norm = d / fmax(r, 1);
+            if (norm < bestNorm) { bestNorm = norm; bestInside = DM_PAD_C_N + i; }
+        } else if (d - r < bestDist) {
+            bestDist = d - r; bestNear = DM_PAD_C_N + i;
+        }
+    }
+    DmPadShape s[20]; int n = dm_pad_shapes(g, _full, s);
+    for (int c = 0; c < DM_PAD_C_N; c++) {
+        if (![self editMovable:c]) continue;
+        for (int i = 0; i < n; i++) if (dm_pad_is_shape_of(s[i].id, c)) {
+            CGFloat d = edit_shape_distance(&s[i], p);
+            if (d <= 0) {
+                CGFloat norm = edit_shape_norm(&s[i], p);
+                if (norm < bestNorm) { bestNorm = norm; bestInside = c; }
+            } else if (d < bestDist) {
+                bestDist = d; bestNear = c;
+            }
+        }
+    }
+    return bestInside >= 0 ? bestInside : bestNear;
+}
+- (CGRect)editBox:(int)c {
