+    CGPoint keyDelta[4];
+    for (int i = 0; i < 4; i++) {
+        CGPoint bk = dm_pad_diamond_key(g.face, baseFaceGap, i);
+        keyDelta[i] = CGPointMake(g.faceKey[i].x - bk.x, g.faceKey[i].y - bk.y);
