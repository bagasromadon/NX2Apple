+// ---- Editing the layout in the game ----
+// "Edit control layout" in the in-game menu (GameMenu.swift, dm_pad_edit_begin) works in a game's own app, which has no shell and so no layout editor of its own, as in the shell.
+// The picture dims, every control of the current layout (2D or 3D) can be dragged to where the player wants it, and a card holds one size for all the controls (DM_TOUCH_SIZE's
+// factor, continuous), one opacity and Reset, Cancel and Done. The moves are the shell editor's: DM_TOUCH_LAYOUT's steps, a quarter of a face key's width each, and the geometry
+// (DmPadGeometry.h) keeps a control inside its area and clear of the others, so a drag that has no room stops at the last place that has (it slides along what blocks it).
+// Done saves the arrangement, the size and the opacity in NSUserDefaults (loadEdits reads them at the next start). A change of DM_TOUCH_LAYOUT or DM_TOUCH_SIZE in the environment
+// (the shell's settings) after that drops the saved edits. Touches belong to the editor while it is open: no key is pressed and nothing reaches the game.
+static NSString *edit_env_stamp(void) {
+    const char *l = getenv("DM_TOUCH_LAYOUT"), *s = getenv("DM_TOUCH_SIZE");
+    return [NSString stringWithFormat:@"%s|%s", l ? l : "", s ? s : ""];
+}
+- (void)loadEdits {
+    NSUserDefaults *d = NSUserDefaults.standardUserDefaults;
+    NSString *stamp = [d stringForKey:k_edit_stamp_key];
+    if (!stamp) return;
+    if (![stamp isEqualToString:edit_env_stamp()]) {   // the shell's settings changed since: its values win
+        for (NSString *k in @[k_edit_layout_key, k_edit_scale_key, k_edit_opacity_key, k_edit_stamp_key]) [d removeObjectForKey:k];
+        LOG("front end: saved layout edits dropped (DM_TOUCH_LAYOUT or DM_TOUCH_SIZE changed)");
+        return;
+    }
+    NSString *text = [d stringForKey:k_edit_layout_key]; DmPadLayout l;
+    if (text && dm_pad_layout_parse(text.UTF8String, &l)) _arrangement = l;
+    double scale = [d doubleForKey:k_edit_scale_key], opacity = [d doubleForKey:k_edit_opacity_key];
+    if (scale >= k_edit_scale_min && scale <= k_edit_scale_max) _opts.scale = scale;
+    if (opacity >= k_edit_opacity_min && opacity <= 1) _opacity = opacity;
+    LOG("front end: touch layout edits loaded (size %.0f%%, opacity %.0f%%, %d moved)", _opts.scale * 100, _opacity * 100, dm_pad_layout_count(&_arrangement));
+}
+- (BOOL)editOffered { return !_tap; }
+- (int)editSet { return (_layout.separated ? DM_PAD_SET_2D_SPLIT : DM_PAD_SET_2D) + (_full ? 1 : 0); }
+- (void)beginEditing {
+    if (_editing || _tap) return;
+    [self reset];
+    _editing = YES; _editSel = -1; _editControl = -1; _editTouch = nil; _editApart = NO; _editCardPlaced = NO;
+    _editStart = _arrangement; _editStartScale = _opts.scale > 0 ? _opts.scale : 1; _editStartOpacity = _opacity;
+    _editScrim = [CALayer layer]; _editScrim.backgroundColor = [UIColor colorWithWhite:0 alpha:0.4].CGColor; [self.layer insertSublayer:_editScrim atIndex:0];
+    _editHalo = [CAShapeLayer layer]; _editHalo.fillColor = nil; _editHalo.strokeColor = [UIColor colorWithWhite:1 alpha:0.95].CGColor; _editHalo.lineWidth = 2;
+    _editHalo.lineDashPattern = @[@7, @5]; _editHalo.hidden = YES; [self.layer addSublayer:_editHalo];
+    _controls.hidden = NO; _menu.userInteractionEnabled = NO;   // the menu button cannot move: it stays, and does nothing, until the editor closes
+    __weak DmGamepad *weak = self;
+    DmPadEditCard *card = [[DmPadEditCard alloc] initWithScale:_editStartScale opacity:_opacity min:k_edit_scale_min max:k_edit_scale_max opacityMin:k_edit_opacity_min];
+    card.onSize = ^(CGFloat v) { [weak editSetScale:v]; };
+    card.onOpacity = ^(CGFloat v) { [weak editSetOpacity:v]; };
+    card.onApart = ^(BOOL on) { DmGamepad *s = weak; if (s) { s->_editApart = on; s->_editSel = -1; [s setNeedsLayout]; } };
+    card.onReset = ^{ [weak editReset]; };
+    card.onCancel = ^{ [weak endEditing:NO]; };
+    card.onDone = ^{ [weak endEditing:YES]; };
+    _editCard = card; [self addSubview:card];
+    LOG("front end: touch layout editor opened");
+    [self setNeedsLayout];
+}
+- (void)editSetScale:(CGFloat)v { _opts.scale = v; _geoValid = NO; [self setNeedsLayout]; }
+- (void)editSetOpacity:(CGFloat)v {
+    _opacity = v;
+    [CATransaction begin]; [CATransaction setDisableActions:YES]; _controls.opacity = v; [CATransaction commit];
+}
