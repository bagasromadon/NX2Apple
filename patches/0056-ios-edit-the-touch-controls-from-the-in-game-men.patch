+static void copy_utf8_clamped(char *out, size_t cap, NSString *s) {
+    if (!cap) return;
+    const char *utf = s.UTF8String ?: "";
+    size_t len = strlen(utf);
+    if (len >= cap) {
+        len = cap - 1;
+        while (len > 0 && (((unsigned char)utf[len] & 0xC0u) == 0x80u)) len--;   // never cut in the middle of a UTF-8 sequence
+    }
+    memcpy(out, utf, len); out[len] = 0;
+}
+- (void)editSaveMacroMask:(uint64_t)mask mode:(int)mode label:(NSString *)lbl {
