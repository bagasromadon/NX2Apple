+    case DM_PAD_C_FACE: return g->face;
+    case DM_PAD_C_A: case DM_PAD_C_B: case DM_PAD_C_X: case DM_PAD_C_Y: return g->faceKey[c - DM_PAD_C_A];
+    case DM_PAD_C_STICK: return g->stick;
+    case DM_PAD_C_DPAD: return g->dpad;
+    case DM_PAD_C_L3: case DM_PAD_C_R3: return g->click[c - DM_PAD_C_L3];
+    case DM_PAD_C_MINUS: case DM_PAD_C_PLUS: return g->pill[c - DM_PAD_C_MINUS].origin;
+    default: return g->drop[c - DM_PAD_C_ZL];
+    }
+}
