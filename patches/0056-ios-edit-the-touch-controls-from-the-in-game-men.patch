+        if (idx < 0) { [self editCloseMacroModal]; return; }
+        DmPadMacro *m = &_macros.items[set][idx];
+        memset(m, 0, sizeof *m);
+        m->active = YES;
+        // Stagger newly added macro buttons across the upper-middle area so multiple additions stay separated and easy to grab.
+        m->nx = 0.50 + ((idx % 3) - 1) * 0.14;
+        m->ny = 0.24 + ((idx / 3) % 3) * 0.16;
+        m->scale = dm_pad_clamp_scale(_opts.scale > 0 ? _opts.scale : 1.0);
+    }
+    DmPadMacro *m = &_macros.items[set][idx];
