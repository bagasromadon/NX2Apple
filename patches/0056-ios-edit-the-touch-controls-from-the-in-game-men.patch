+// The value for DM_TOUCH_LAYOUT as dm_pad_layout_parse reads it (the shell writes the same form, TouchLayout.encoded): "" when no control is moved,
+// otherwise "1", then ";", the layout's name and "/control:dx,dy" for each moved control, layouts and controls in their enum order. The in-game
+// layout editor (DmGamepad.m, "Edit control layout") saves its arrangement with it. Returns the length, or -1 when out (cap bytes, at least
+// DM_PAD_LAYOUT_MAX + 1 always holds it) is too small; out then holds "".
+static inline int dm_pad_layout_encode(const DmPadLayout *l, char *out, size_t cap) {
+    size_t n = 0;
+    if (cap) out[0] = 0;
+    for (int s = 0; s < DM_PAD_SET_N; s++) {
+        BOOL any = NO;
+        for (int c = 0; c < DM_PAD_C_N; c++) if (l->dx[s][c] || l->dy[s][c]) any = YES;
+        if (!any) continue;
+        for (int pass = 0; pass < 1 + DM_PAD_C_N; pass++) {
+            int w = 0;
+            if (pass == 0) w = snprintf(out + n, cap - n, "%s;%s", n ? "" : "1", dm_pad_set_names[s]);
+            else if (l->dx[s][pass - 1] || l->dy[s][pass - 1]) w = snprintf(out + n, cap - n, "/%s:%d,%d", dm_pad_control_names[pass - 1], l->dx[s][pass - 1], l->dy[s][pass - 1]);
+            else continue;
+            if (w < 0 || (size_t)w >= cap - n) { if (cap) out[0] = 0; return -1; }
+            n += (size_t)w;
+        }
+    }
+    return (int)n;
+}
